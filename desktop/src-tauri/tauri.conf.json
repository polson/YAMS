{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAMS",
  "version": "0.2.2",
  "identifier": "io.yams.separator",
  "build": {
    "beforeDevCommand": "npm run prepare-engine && npm run dev",
    "beforeBuildCommand": "npm run prepare-engine && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../../yams", "../../yass"]
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "YAMS",
      "decorations": false,
      "backgroundColor": "#10151b",
      "width": 1120,
      "height": 800,
      "minWidth": 760,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Music stem separation for YARG",
    "longDescription": "Separate songs into instrument tracks for YARG.",
    "resources": { "../.cache/engine/": "engine/" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMzFBQTNBRUIxM0NBQjYKUldTMnloUHJPcW94S2lZSy9ZTzM3QUhYSjdEZUdkWHZEY0pvcGN4anF6L1JuUWR2em4xcnZwbm8K",
      "endpoints": ["https://github.com/polson/YAMS/releases/latest/download/latest.json"]
    }
  }
}
